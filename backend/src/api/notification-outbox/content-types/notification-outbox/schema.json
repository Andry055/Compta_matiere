{
  "kind": "collectionType",
  "collectionName": "notification_outboxes",
  "info": {
    "singularName": "notification-outbox",
    "pluralName": "notification-outboxes",
    "displayName": "Notification Outbox",
    "description": "File d'attente persistante des notifications (outbox pattern) pour garantir l'idempotence et la reprise après échec des envois SSE."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "sortie": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sortie.sortie",
      "required": false
    },
    "demande": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::demande.demande",
      "required": false
    },
    "eventType": {
      "type": "enumeration",
      "enum": [
        "ordre_pret_distribution",
        "ordre_sortie_autorise",
        "demande_aboutie",
        "nouvelle_demande",
        "preparation_terminee",
        "preparation_rejetee"
      ],
      "required": true
    },
    "recipientId": {
      "type": "integer",
      "required": false
    },
    "recipientRole": {
      "type": "string",
      "required": false
    },
    "cleUnicite": {
      "type": "string",
      "required": false,
      "unique": true
    },
    "payload": {
      "type": "json",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "processing", "sent", "failed"],
      "default": "pending",
      "required": true
    },
    "attempts": {
      "type": "integer",
      "default": 0,
      "required": true
    },
    "lastAttemptAt": {
      "type": "datetime"
    },
    "lastError": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime"
    },
    "updatedAt": {
      "type": "datetime"
    }
  }
}
